# ─── Supabase / Postgres ─────────────────────────────────────────────────
# Get these from https://supabase.com (free tier is plenty for personal use):
#   1. Create a project
#   2. Settings -> Database -> Connection string -> "Transaction pooler"
#   3. Settings -> API -> URL and anon key

# Pooled connection (for app runtime)
DATABASE_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (for migrations / Prisma)
DIRECT_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# ─── Card data sources (no auth required) ────────────────────────────────
RIFTSCRIBE_API_BASE="https://riftscribe.gg/api"
RIFTCODEX_API_BASE="https://api.riftcodex.com"

# ─── Price sources ───────────────────────────────────────────────────────
# TCGPlayer prices via TCGCSV (free, no auth)
TCGCSV_BASE="https://tcgcsv.com"
# Riftbound's TCGplayer category id - check https://tcgcsv.com/tcgplayer/ to confirm.
# (As of the project's writing it's category 89 but verify on first run.)
TCGPLAYER_CATEGORY_ID="89"

# Cardmarket via cardmarket-api.com (third-party, 100 req/day free tier)
# Sign up at https://www.cardmarket-api.com to get a key. Leave blank to disable.
CARDMARKET_API_KEY=""
CARDMARKET_API_BASE="https://api.cardmarket-api.com"

# ─── App config ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Riftbound Vault"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to "true" once you've configured Supabase Auth (login enabled).
# When false, the app runs in single-user mode using DEFAULT_USER_ID below.
NEXT_PUBLIC_REQUIRE_AUTH="false"

# Default user id when running in single-user mode.
DEFAULT_USER_ID="local-user"

# ─── Push notifications (Web Push, VAPID) ────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
# Then paste the keys here. Leave blank to disable push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu@email.com"
